# Application
NODE_ENV=development
API_PORT=3000

# Database
## PostgresSQL
DATABASE_HOST=localhost
DATABASE_USER=ozeille
DATABASE_PASSWORD=ozeille
DATABASE_NAME=ozeille

## To use for docker if default port is already assigned
DATABASE_PORT=5432

# Connection string
# Without docker
# DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:5432/${DATABASE_NAME}
# With docker
# DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@db:5432/${DATABASE_NAME}

# Redis
# Uncomment if you want to use Redis without docker
# REDIS_HOST=localhost
REDIS_PORT=6379

# Mailer
# Uncomment if you want to user mail without docker
# MAILER_HOST=localhost
# MAILER_PORT=1025
# MAILER_USER=
# MAILER_PASSWORD=
MAILER_FROM=noreply@lapince.com

# Docker variables for mailpit
MAILPIT_WEB_PORT=8025
MAILPIT_SMTP_PORT=1025

# JWT / Security
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# Frontend URL (for email links)
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000