model Category {
  id String @id @default(uuid())
  
  budgetId String   @map("budget_id")
  budget Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  label String  @db.VarChar(30)
  color String? @db.VarChar(7)
  
  userId       String?  @map("user_id")

  limitAmount  Decimal  @default(0) @db.Decimal(10, 2) @map("limit_amount")

  transactions Transaction[]
  
  // Contrainte unique : "label + user_id + budget_id"
  // Empêcher d'avoir deux fois une catégorie pour le même user dans le même budget 
  @@unique([label, userId, budgetId], name: "unique_category_per_budget_user")


  // Contrainte unique : "label + user_id + budget_id"
  // Dans toute l'application, un même utilisateur ne peut pas avoir deux catégories avec le même label
  @@unique([label, userId], name: "unique_category_per_user")
  
  @@map("categories")
}