{
  "moduleFileExtensions": ["ts", "js", "json"],
  "rootDir": ".",
  "testEnvironment": "node",
  "preset": "ts-jest",
  "testMatch": ["**/*.spec.ts", "**/*.ti.spec.ts", "**/*.e2e-spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/src/$1"
  },
  "testTimeout": 15000,
  "maxWorkers": 1,
  "forceExit": true,
  "detectOpenHandles": false
}
