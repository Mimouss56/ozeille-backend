model Transaction {
  id        String    @id @default(uuid())
  amount    Float
  label     String    @db.VarChar(30)
  dueAt     DateTime  @map("due_at")
  pointedAt DateTime? @map("pointed_at") @db.Timestamptz(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(0)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(0)
  
  // endDate   DateTime? @map("end_date")
  
  categoryId String?   @map("category_id") // nullable 
  category   Category? @relation(fields: [categoryId], references: [id])

  frequencyId String?    @map("frequency_id")
  frequency   Frequency? @relation(fields: [frequencyId], references: [id])

  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  
  @@index([dueAt, userId])
  @@index([categoryId, dueAt])
  @@map("transactions")
}
